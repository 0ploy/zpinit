# Copy to .devcontainer/.env (git ignored) and fill in. Compose reads it at
# container start; a change needs a container restart.

# Fine-grained GitHub PAT on 0ploy/zpinit (Contents read/write, Pull requests
# read/write). Authenticates gh and, via `gh auth git-credential`, git itself.
GH_TOKEN=

# Commit email used inside the container (user.name comes from ~/.gitconfig).
GIT_EMAIL=
